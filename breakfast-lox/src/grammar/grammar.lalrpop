use crate::ast;

grammar;

pub BoolLit : ast::BoolLit = {
    "true" => ast::BoolLit(true),
    "false" => ast::BoolLit(false),
}

pub NilLit : ast::NilLit = {
    "nil" => ast::NilLit,
}

pub NumLit : ast::NumLit = {
    // Floating constants per ISO/IEC 9899:1999 §6.4.4.2

    // Decimal floating constants
    r"[0-9]+\.([0-9]+)?([eE][+-]?[0-9]+)?" => ast::NumLit(f64::from_str(<>).unwrap()),
    r"[0-9]+[eE][+-]?[0-9]+" => ast::NumLit(f64::from_str(<>).unwrap()),
    r"\.[0-9]+([eE][+-]?[0-9]+)?" => ast::NumLit(f64::from_str(<>).unwrap()),

    // Hexadecimal floating constants
    r"0[xX][0-9a-fA-F]+\.?[0-9a-fA-F]*[pP][+-]?[0-9]+" => ast::NumLit(hexf_parse::parse_f64(<>, false).unwrap()),
    r"0[xX]\.[0-9a-fA-F]+[pP][+-]?[0-9]+" => ast::NumLit(hexf_parse::parse_f64(<>, false).unwrap()),
}

pub StringLit : ast::StringLit = {
    r#""[ -!#-\[\]-~\\]*""# => ast::StringLit::from_raw(<>),
}

pub BinOp : ast::BinOp = {
    "==" => ast::BinOp::Eq,
    "!=" => ast::BinOp::Ne,
    "<" => ast::BinOp::Lt,
    "<=" => ast::BinOp::Le,
    ">" => ast::BinOp::Gt,
    ">=" => ast::BinOp::Ge,
    "+" => ast::BinOp::Add,
    "-" => ast::BinOp::Sub,
    "*" => ast::BinOp::Mul,
    "/" => ast::BinOp::Div,
}

pub UnaryOp : ast::UnaryOp = {
    "-" => ast::UnaryOp::Neg,
    "!" => ast::UnaryOp::Not,
}

