use crate::ast;
use std::str::FromStr;
use super::parse_error;
use super::parse_error::NumLitParseError;
use super::parse_error::DecimalFloatingPointLiteralParseError;
use super::parse_error::HexadecimalFloatingPointLiteralParseError;
use super::parse_error::IntegerLiteralParseError;
use super::parse_error::NumberIsNotFiniteParseError;

grammar;

extern {
    type Error = parse_error::ParseError;
}

match {
    // whitespace
    r"\s+" => {},
    // line comments
    r"//[^\n]*" => {},
    // block comments
    // TODO(kostya): Support nested comments (this will require moving to a custom lexer.
    // TODO(kostya): Support comments in the AST. This will mean that (1) comments must be modelled
    // in the AST (2) a decision must be made on where to attach comments. This will be required to
    // implement a formatter.
    r"/\*[^*]*\*+([^/*][^*]*\*+)*/" => {},
    "nil" => KWRD_NIL,
    "print" => KWRD_PRINT,
    "var" => KWRD_VAR,
    "true" => KWRD_TRUE,
    "false" => KWRD_FALSE,
    "if" => KWRD_IF,
    "else" => KWRD_ELSE,
    r"[a-zA-Z_][a-zA-Z0-9_]*" => IDENTIFIER,
    // Decimal and hexademical floating constants as per ISO/IEC 9899:1999 §6.4.4.2
    r"[0-9]+\.([0-9]+)?([eE][+-]?[0-9]+)?|[0-9]+[eE][+-]?[0-9]+|\.[0-9]+([eE][+-]?[0-9]+)?" => DEC_FLOAT,
    r"0[xX][0-9a-fA-F]+\.?[0-9a-fA-F]*[pP][+-]?[0-9]+|0[xX]\.[0-9a-fA-F]+[pP][+-]?[0-9]+" => HEX_FLOAT, 
    r"[0-9]+" => INTEGER,
    r#""[ -!#-\[\]-~\\]*""# => STRING,
    _
}

NilLit : ast::NilLit = {
    KWRD_NIL => ast::NilLit,
}

BoolLit : ast::BoolLit = {
    KWRD_TRUE => ast::BoolLit(true),
    KWRD_FALSE => ast::BoolLit(false),
}

// TODO(kostya): These [is_finite] checks don't actually work in practice, there should be a better
// way of doing it. 
NumLit : ast::NumLit = {
    DEC_FLOAT =>? {
        let x = 
            f64::from_str(<>)
                .map_err(|source| 
                    parse_error::ParseError::NumLit(
                        NumLitParseError::DecimalFloatingPointLiteral(
                            DecimalFloatingPointLiteralParseError {
                                token : <>.into(),
                                source : source.into(),
                            })))?;
        if x.is_finite() {
            Ok(ast::NumLit(x))
        } else {
            Err(
                parse_error::ParseError::NumLit(
                    NumLitParseError::NumberIsNotFinite(
                        NumberIsNotFiniteParseError {
                            token : <>.into(),
                            })))?
        }
    },
    HEX_FLOAT =>? {
        let x = 
            hexf_parse::parse_hexf64(<>, false)
                .map_err(|source|
                        parse_error::ParseError::NumLit(
                            NumLitParseError::HexadecimalFloatingPointLiteral(
                                HexadecimalFloatingPointLiteralParseError {
                                    token : <>.into(),
                                    source : source.into(),
                                })))?;
        if x.is_finite() {
            Ok(ast::NumLit(x))
        } else {
            Err(
                parse_error::ParseError::NumLit(
                    NumLitParseError::NumberIsNotFinite(
                        NumberIsNotFiniteParseError {
                            token : <>.into(),
                            })))?
        }
    },
    INTEGER =>? {
        let x = 
            f64::from_str(<>)
                .map_err(|source| 
                         parse_error::ParseError::NumLit(
                            NumLitParseError::IntegerLiteral(
                                IntegerLiteralParseError {
                                    token : <>.into(),
                                    source : source.into(),
                                })))?;
        if x.is_finite() {
            Ok(ast::NumLit(x))
        } else {
            Err(
                parse_error::ParseError::NumLit(
                    NumLitParseError::NumberIsNotFinite(
                        NumberIsNotFiniteParseError {
                            token : <>.into(),
                            })))?
        }
    },
}

StrLit : ast::StrLit = {
    STRING => ast::StrLit::from_raw(<>),
}

Lit : ast::Lit = {
    NilLit => ast::Lit::Nil(<>),
    BoolLit => ast::Lit::Bool(<>),
    NumLit => ast::Lit::Num(<>),
    StrLit => ast::Lit::Str(<>),
}

VarName : ast::VarName = {
    IDENTIFIER => ast::VarName::new(<>),
}

UnOp : ast::UnOp = {
    "-" => ast::UnOp::Neg,
    "!" => ast::UnOp::Not,
}

EqOp : ast::EqOp = {
    "==" => ast::EqOp::Eq,
    "!=" => ast::EqOp::Ne,
}

CmpOp : ast::CmpOp = {
    "<" => ast::CmpOp::Lt,
    "<=" => ast::CmpOp::Le,
    ">" => ast::CmpOp::Gt,
    ">=" => ast::CmpOp::Ge,
}

AddOp : ast::AddOp = {
    "+" => ast::AddOp::Add,
    "-" => ast::AddOp::Sub,
}

MulOp : ast::MulOp = {
    "*" => ast::MulOp::Mul,
    "/" => ast::MulOp::Div,
}

pub Expr : ast::Expr = {
    Assign => ast::Expr::Assign(<>),
    EqExpr,
}

Assign : ast::Assign = {
    <name:VarName> "=" <val:Expr> => ast::Assign { name , val : Box::new(val) },
}

EqExpr : ast::Expr = {
    <l:EqExpr> <op:EqOp> <r:CmpExpr> => {
        let op = ast::BinOp::Rel(ast::RelOp::Eq(op));
        let l = Box::new(l);
        let r = Box::new(r);
        ast::Expr::Bin(ast::BinExpr { op, l, r })
    },
    CmpExpr 
}

CmpExpr : ast::Expr = {
    <l:TermExpr> <op:CmpOp> <r:CmpExpr> => {
        let op = ast::BinOp::Rel(ast::RelOp::Cmp(op));
        let l = Box::new(l);
        let r = Box::new(r);
        ast::Expr::Bin(ast::BinExpr { op, l, r })
    },
    TermExpr 
}

TermExpr : ast::Expr = {
    <l:FactorExpr> <op:AddOp> <r:TermExpr> => {
        let op = ast::BinOp::Add(op);
        let l = Box::new(l);
        let r = Box::new(r);
        ast::Expr::Bin(ast::BinExpr { op, l, r})
    },
    FactorExpr 
}

FactorExpr : ast::Expr = {
    <l:UnExpr> <op:MulOp> <r:FactorExpr> => {
        let op = ast::BinOp::Mul(op);
        let l = Box::new(l);
        let r = Box::new(r);
        ast::Expr::Bin(ast::BinExpr { op, l, r })
    },
    UnExpr
}

UnExpr : ast::Expr = {
    <op:UnOp> <e:UnExpr> => ast::Expr::Un(ast::UnExpr { op, e : Box::new(e) }),
    PrimExpr,
}

PrimExpr : ast::Expr = {
    Lit => ast::Expr::Lit(<>),
    VarName => ast::Expr::Var(<>),
    "(" <Expr> ")"
}

pub Prog : ast::Prog = {
    DeclStmt* => ast::Prog(<>),
}

Stmt : ast::Stmt = {
    MatchedStmt,
    UnmatchedStmt,
}

NonIfStmt : ast::Stmt = {
    ExprStmt => ast::Stmt::Expr(<>),
    PrintStmt => ast::Stmt::Print(<>),
    Block => ast::Stmt::Block(Box::new(<>)),
}

MatchedStmt : ast::Stmt = { 
    NonIfStmt,
    KWRD_IF "(" <cond:Expr> ")" <then:MatchedStmt> KWRD_ELSE <else_:MatchedStmt> =>
        ast::Stmt::If(Box::new(ast::IfStmt { cond, then, else_: Some(else_) })),
}

UnmatchedStmt : ast::Stmt = {
    KWRD_IF "(" <cond:Expr> ")" <then:Stmt> =>
        ast::Stmt::If(Box::new(ast::IfStmt { cond, then, else_: None })),
    KWRD_IF "(" <cond:Expr> ")" <then:MatchedStmt> KWRD_ELSE <else_:UnmatchedStmt> =>
        ast::Stmt::If(Box::new(ast::IfStmt { cond, then, else_: Some(else_) })),
}

VarDecl : ast::VarDecl = {
    KWRD_VAR <name:VarName> <init:("=" <Expr>)?> ";" => ast::VarDecl { name , init },
}


DeclStmt : ast::Stmt = {
    VarDecl => ast::Stmt::VarDecl(<>),
    Stmt,
}

Block : ast::Block = {
    "{" <DeclStmt*> "}" => ast::Block(<>),
}

ExprStmt : ast::ExprStmt = {
    <Expr> ";" => ast::ExprStmt(<>),
}

PrintStmt : ast::PrintStmt = {
    KWRD_PRINT <Expr> ";" => ast::PrintStmt(<>),
}
