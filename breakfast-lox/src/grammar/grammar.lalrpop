use crate::ast;
use super::parse_error;
use super::grammar_support::{
    ForInit, desugar_for_stmt, parse_decimal_float, parse_hex_float, parse_decimal_int_as_float, validate_arg_count};

// Full grammar as per https://craftinginterpreters.com/appendix-i.html
//
// program        → declaration* EOF ;
// declaration    → classDecl
//                | funDecl
//                | varDecl
//                | statement ;
// 
// classDecl      → "class" IDENTIFIER ( "<" IDENTIFIER )?
//                  "{" function* "}" ;
// funDecl        → "fun" function ;
// varDecl        → "var" IDENTIFIER ( "=" expression )? ";" ;
//
// statement      → exprStmt
//                | forStmt
//                | ifStmt
//                | printStmt
//                | returnStmt
//                | whileStmt
//                | block ;
// 
// exprStmt       → expression ";" ;
// forStmt        → "for" "(" ( varDecl | exprStmt | ";" )
//                            expression? ";"
//                            expression? ")" statement ;
// ifStmt         → "if" "(" expression ")" statement
//                  ( "else" statement )? ;
// printStmt      → "print" expression ";" ;
// returnStmt     → "return" expression? ";" ;
// whileStmt      → "while" "(" expression ")" statement ;
// block          → "{" declaration* "}" ;
//
// expression     → assignment ;
// 
// assignment     → ( call "." )? IDENTIFIER "=" assignment
//                | logic_or ;
// 
// logic_or       → logic_and ( "or" logic_and )* ;
// logic_and      → equality ( "and" equality )* ;
// equality       → comparison ( ( "!=" | "==" ) comparison )* ;
// comparison     → term ( ( ">" | ">=" | "<" | "<=" ) term )* ;
// term           → factor ( ( "-" | "+" ) factor )* ;
// factor         → unary ( ( "/" | "*" ) unary )* ;
// 
// unary          → ( "!" | "-" ) unary | call ;
// call           → primary ( "(" arguments? ")" | "." IDENTIFIER )* ;
// primary        → "true" | "false" | "nil" | "this"
//                | NUMBER | STRING | IDENTIFIER | "(" expression ")"
//                | "super" "." IDENTIFIER ;
//
// function       → IDENTIFIER "(" parameters? ")" block ;
// parameters     → IDENTIFIER ( "," IDENTIFIER )* ;
// arguments      → expression ( "," expression )* ;
//
// NUMBER         → DIGIT+ ( "." DIGIT+ )? ;
// STRING         → "\"" <any char except "\"">* "\"" ;
// IDENTIFIER     → ALPHA ( ALPHA | DIGIT )* ;
// ALPHA          → "a" ... "z" | "A" ... "Z" | "_" ;
// DIGIT          → "0" ... "9" ;

grammar;

extern {
    type Error = parse_error::ParseError;
}

match {
    // whitespace
    r"\s+" => {},
    // line comments
    r"//[^\n]*" => {},
    // block comments
    // TODO(kostya): Support nested comments (this will require moving to a custom lexer.
    // TODO(kostya): Support comments in the AST. This will mean that (1) comments must be modelled
    // in the AST (2) a decision must be made on where to attach comments. This will be required to
    // implement a formatter.
    r"/\*[^*]*\*+([^/*][^*]*\*+)*/" => {},
    "nil" => KWRD_NIL,
    "print" => KWRD_PRINT,
    "var" => KWRD_VAR,
    "true" => KWRD_TRUE,
    "false" => KWRD_FALSE,
    "if" => KWRD_IF,
    "else" => KWRD_ELSE,
    "or" => KWRD_OR,
    "and" => KWRD_AND,
    "while" => KWRD_WHILE,
    "for" => KWRD_FOR,
    "break" => KWRD_BREAK,
    r"[a-zA-Z_][a-zA-Z0-9_]*" => IDENTIFIER,
    // Decimal and hexademical floating constants as per ISO/IEC 9899:1999 §6.4.4.2
    r"[0-9]+\.([0-9]+)?([eE][+-]?[0-9]+)?|[0-9]+[eE][+-]?[0-9]+|\.[0-9]+([eE][+-]?[0-9]+)?" => DEC_FLOAT,
    r"0[xX][0-9a-fA-F]+\.?[0-9a-fA-F]*[pP][+-]?[0-9]+|0[xX]\.[0-9a-fA-F]+[pP][+-]?[0-9]+" => HEX_FLOAT, 
    r"[0-9]+" => INTEGER,
    r#""[ -!#-\[\]-~\\]*""# => STRING,
    _
}

NilLit : ast::NilLit = {
    KWRD_NIL => ast::NilLit,
}

BoolLit : ast::BoolLit = {
    KWRD_TRUE => ast::BoolLit(true),
    KWRD_FALSE => ast::BoolLit(false),
}

NumLit : ast::NumLit = {
    DEC_FLOAT =>? Ok(parse_decimal_float(<>)?),
    HEX_FLOAT =>? Ok(parse_hex_float(<>)?),
    INTEGER =>? Ok(parse_decimal_int_as_float(<>)?),
}

StrLit : ast::StrLit = {
    STRING => ast::StrLit::from_raw(<>),
}

Lit : ast::Lit = {
    NilLit => ast::Lit::Nil(<>),
    BoolLit => ast::Lit::Bool(<>),
    NumLit => ast::Lit::Num(<>),
    StrLit => ast::Lit::Str(<>),
}

VarName : ast::VarName = {
    IDENTIFIER => ast::VarName::new(<>),
}

UnOp : ast::UnOp = {
    "-" => ast::UnOp::Neg,
    "!" => ast::UnOp::Not,
}

EqOp : ast::EqOp = {
    "==" => ast::EqOp::Eq,
    "!=" => ast::EqOp::Ne,
}

CmpOp : ast::CmpOp = {
    "<" => ast::CmpOp::Lt,
    "<=" => ast::CmpOp::Le,
    ">" => ast::CmpOp::Gt,
    ">=" => ast::CmpOp::Ge,
}

AddOp : ast::AddOp = {
    "+" => ast::AddOp::Add,
    "-" => ast::AddOp::Sub,
}

MulOp : ast::MulOp = {
    "*" => ast::MulOp::Mul,
    "/" => ast::MulOp::Div,
}

pub Expr : ast::Expr = {
    Assign => ast::Expr::Assign(<>),
    LogOr,
}

Assign : ast::Assign = {
    <name:VarName> "=" <val:Expr> => ast::Assign { name , val : Box::new(val) },
}

LogOr : ast::Expr = {
    LogAnd,
    <l:LogOr> KWRD_OR <r:LogAnd> => {
        let op = ast::BinOp::Log(ast::LogOp::Or);
        let l = Box::new(l);
        let r = Box::new(r);
        ast::Expr::Bin(ast::BinExpr { op, l, r })
    },
}

LogAnd : ast::Expr = {
    EqExpr,
    <l:LogAnd> KWRD_AND <r:EqExpr> => {
        let op = ast::BinOp::Log(ast::LogOp::And);
        let l = Box::new(l);
        let r = Box::new(r);
        ast::Expr::Bin(ast::BinExpr { op, l, r })
    },
}

EqExpr : ast::Expr = {
    <l:EqExpr> <op:EqOp> <r:CmpExpr> => {
        let op = ast::BinOp::Rel(ast::RelOp::Eq(op));
        let l = Box::new(l);
        let r = Box::new(r);
        ast::Expr::Bin(ast::BinExpr { op, l, r })
    },
    CmpExpr,
}

CmpExpr : ast::Expr = {
    <l:TermExpr> <op:CmpOp> <r:CmpExpr> => {
        let op = ast::BinOp::Rel(ast::RelOp::Cmp(op));
        let l = Box::new(l);
        let r = Box::new(r);
        ast::Expr::Bin(ast::BinExpr { op, l, r })
    },
    TermExpr, 
}

TermExpr : ast::Expr = {
    <l:FactorExpr> <op:AddOp> <r:TermExpr> => {
        let op = ast::BinOp::Add(op);
        let l = Box::new(l);
        let r = Box::new(r);
        ast::Expr::Bin(ast::BinExpr { op, l, r})
    },
    FactorExpr ,
}

FactorExpr : ast::Expr = {
    <l:UnExpr> <op:MulOp> <r:FactorExpr> => {
        let op = ast::BinOp::Mul(op);
        let l = Box::new(l);
        let r = Box::new(r);
        ast::Expr::Bin(ast::BinExpr { op, l, r })
    },
    UnExpr,
}

UnExpr : ast::Expr = {
    <op:UnOp> <e:UnExpr> => ast::Expr::Un(ast::UnExpr { op, e : Box::new(e) }),
    CallExpr => <>
}

CallExpr : ast::Expr = {
    PrimExpr => <>,
    <callee:PrimExpr> "(" <args:Args?> ")" =>? {
        let args =  args.unwrap_or_default();
        validate_arg_count(args.len())?;
        Ok(ast::Expr::Call(ast::Call { callee : Box::new(callee), args  }))
    }
}

Args : Vec<ast::Expr> = {
    <first:Expr> <rest:("," <Expr>)*> => {
        let mut args = vec![first];
        args.extend(rest);
        args
    }
}

PrimExpr : ast::Expr = {
    Lit => ast::Expr::Lit(<>),
    VarName => ast::Expr::Var(<>),
    "(" <Expr> ")"
}

pub Prog : ast::Prog = {
    DeclStmt* => ast::Prog(<>),
}

Stmt : ast::Stmt = {
    MatchedStmt,
    UnmatchedStmt,
}

NonIfWhileForStmt : ast::Stmt = {
    ExprStmt => ast::Stmt::Expr(<>),
    PrintStmt => ast::Stmt::Print(<>),
    Block => ast::Stmt::Block(Box::new(<>)),
    KWRD_BREAK ";" => ast::Stmt::Break,
}

MatchedStmt : ast::Stmt = { 
    NonIfWhileForStmt,
    KWRD_IF "(" <cond:Expr> ")" <then:MatchedStmt> KWRD_ELSE <else_:MatchedStmt> =>
        ast::Stmt::If(Box::new(ast::IfStmt { cond, then, else_: Some(else_) })),
    KWRD_WHILE "(" <cond:Expr> ")" <body:MatchedStmt> =>
        ast::Stmt::While(Box::new(ast::WhileStmt { cond, body })),
    KWRD_FOR "(" <init:ForInit> <cond:Expr?> ";" <incr:Expr?> ")" <body:MatchedStmt> => 
        desugar_for_stmt(init, cond, incr, body),
}

UnmatchedStmt : ast::Stmt = {
    KWRD_IF "(" <cond:Expr> ")" <then:Stmt> =>
        ast::Stmt::If(Box::new(ast::IfStmt { cond, then, else_: None })),
    KWRD_IF "(" <cond:Expr> ")" <then:MatchedStmt> KWRD_ELSE <else_:UnmatchedStmt> =>
        ast::Stmt::If(Box::new(ast::IfStmt { cond, then, else_: Some(else_) })),
    KWRD_WHILE "(" <cond:Expr> ")" <body:UnmatchedStmt> =>
        ast::Stmt::While(Box::new(ast::WhileStmt { cond, body })),
    KWRD_FOR "(" <init:ForInit> <cond:Expr?> ";" <incr:Expr?> ")" <body:UnmatchedStmt> => 
        desugar_for_stmt(init, cond, incr, body),
}

ForInit : Option<ForInit> = {
    VarDecl => Some(ForInit::VarDecl(<>)),
    ExprStmt => Some(ForInit::Expr(<>)),
    ";" => None
}

VarDecl : ast::VarDecl = {
    KWRD_VAR <name:VarName> <init:("=" <Expr>)?> ";" => ast::VarDecl { name , init },
}


DeclStmt : ast::Stmt = {
    VarDecl => ast::Stmt::VarDecl(<>),
    Stmt,
}

WhileStmt : ast::WhileStmt = {
    KWRD_WHILE "(" <cond:Expr> ")" <body:Stmt> => ast::WhileStmt { cond, body },
}

Block : ast::Block = {
    "{" <DeclStmt*> "}" => ast::Block(<>),
}

ExprStmt : ast::ExprStmt = {
    <Expr> ";" => ast::ExprStmt(<>),
}

PrintStmt : ast::PrintStmt = {
    KWRD_PRINT <Expr> ";" => ast::PrintStmt(<>),
}
