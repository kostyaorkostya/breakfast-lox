use crate::ast;
use super::parse_error;
use super::grammar_support::{
    ForInit, desugar_for_stmt, parse_decimal_float, parse_hex_float, parse_decimal_int_as_float, validate_arg_count};

// Full grammar as per https://craftinginterpreters.com/appendix-i.html
//
// Note that this is a grammar for "vanilla" Lox, it doesn't cover some things like lambda
// functions.
//
// program        → declaration* EOF ;
// declaration    → classDecl
//                | funDecl
//                | varDecl
//                | statement ;
// 
// classDecl      → "class" IDENTIFIER ( "<" IDENTIFIER )?
//                  "{" function* "}" ;
// funDecl        → "fun" function ;
// varDecl        → "var" IDENTIFIER ( "=" expression )? ";" ;
//
// statement      → exprStmt
//                | forStmt
//                | ifStmt
//                | printStmt
//                | returnStmt
//                | whileStmt
//                | block ;
// 
// exprStmt       → expression ";" ;
// forStmt        → "for" "(" ( varDecl | exprStmt | ";" )
//                            expression? ";"
//                            expression? ")" statement ;
// ifStmt         → "if" "(" expression ")" statement
//                  ( "else" statement )? ;
// printStmt      → "print" expression ";" ;
// returnStmt     → "return" expression? ";" ;
// whileStmt      → "while" "(" expression ")" statement ;
// block          → "{" declaration* "}" ;
//
// expression     → assignment ;
// 
// assignment     → ( call "." )? IDENTIFIER "=" assignment
//                | logic_or ;
// 
// logic_or       → logic_and ( "or" logic_and )* ;
// logic_and      → equality ( "and" equality )* ;
// equality       → comparison ( ( "!=" | "==" ) comparison )* ;
// comparison     → term ( ( ">" | ">=" | "<" | "<=" ) term )* ;
// term           → factor ( ( "-" | "+" ) factor )* ;
// factor         → unary ( ( "/" | "*" ) unary )* ;
// 
// unary          → ( "!" | "-" ) unary | call ;
// call           → primary ( "(" arguments? ")" | "." IDENTIFIER )* ;
// primary        → "true" | "false" | "nil" | "this"
//                | NUMBER | STRING | IDENTIFIER | "(" expression ")"
//                | "super" "." IDENTIFIER ;
//
// function       → IDENTIFIER "(" parameters? ")" block ;
// parameters     → IDENTIFIER ( "," IDENTIFIER )* ;
// arguments      → expression ( "," expression )* ;
//
// NUMBER         → DIGIT+ ( "." DIGIT+ )? ;
// STRING         → "\"" <any char except "\"">* "\"" ;
// IDENTIFIER     → ALPHA ( ALPHA | DIGIT )* ;
// ALPHA          → "a" ... "z" | "A" ... "Z" | "_" ;
// DIGIT          → "0" ... "9" ;

grammar(ids: &mut dyn ast::NodeIdGen);

extern {
    type Error = parse_error::ParseError;
}

match {
    // whitespace
    r"\s+" => {},
    // line comments
    r"//[^\n]*" => {},
    // block comments
    // TODO(kostya): Support nested comments (this will require moving to a custom lexer.
    // TODO(kostya): Support comments in the AST. This will mean that (1) comments must be modelled
    // in the AST (2) a decision must be made on where to attach comments. This will be required to
    // implement a formatter.
    r"/\*[^*]*\*+([^/*][^*]*\*+)*/" => {},
    "nil" => KWRD_NIL,
    "print" => KWRD_PRINT,
    "var" => KWRD_VAR,
    "true" => KWRD_TRUE,
    "false" => KWRD_FALSE,
    "if" => KWRD_IF,
    "else" => KWRD_ELSE,
    "or" => KWRD_OR,
    "and" => KWRD_AND,
    "while" => KWRD_WHILE,
    "for" => KWRD_FOR,
    "break" => KWRD_BREAK,
    "fun" => KWRD_FUN,
    "return" => KWRD_RETURN,
    r"[a-zA-Z_][a-zA-Z0-9_]*" => IDENTIFIER,
    // Decimal and hexademical floating constants as per ISO/IEC 9899:1999 §6.4.4.2
    r"[0-9]+\.([0-9]+)?([eE][+-]?[0-9]+)?|[0-9]+[eE][+-]?[0-9]+|\.[0-9]+([eE][+-]?[0-9]+)?" => DEC_FLOAT,
    r"0[xX][0-9a-fA-F]+\.?[0-9a-fA-F]*[pP][+-]?[0-9]+|0[xX]\.[0-9a-fA-F]+[pP][+-]?[0-9]+" => HEX_FLOAT, 
    r"[0-9]+" => INTEGER,
    r#""[ -!#-\[\]-~\\]*""# => STRING,
    _
}

NilLit : ast::NilLit = {
    KWRD_NIL => ast::NilLit,
}

BoolLit : ast::BoolLit = {
    KWRD_TRUE => ast::BoolLit(true),
    KWRD_FALSE => ast::BoolLit(false),
}

NumLit : ast::NumLit = {
    DEC_FLOAT =>? Ok(parse_decimal_float(<>)?),
    HEX_FLOAT =>? Ok(parse_hex_float(<>)?),
    INTEGER =>? Ok(parse_decimal_int_as_float(<>)?),
}

StrLit : ast::StrLit = {
    STRING => ast::StrLit::from_raw(<>),
}

Lit : ast::Node<ast::Lit> = {
    <start: @L> <lit:NilLit> <end: @R> => 
        ast::node(ids, start..end, ast::Lit::Nil(lit)),
    <start: @L> <lit:BoolLit> <end: @R> => 
        ast::node(ids, start..end, ast::Lit::Bool(lit)),
    <start: @L> <lit:NumLit> <end: @R> =>
        ast::node(ids, start..end, ast::Lit::Num(lit)),
    <start: @L> <lit:StrLit> <end: @R> =>
        ast::node(ids, start..end, ast::Lit::Str(lit)),
}

VarName : ast::Node<ast::VarName> = {
    <start: @L> <var_name:IDENTIFIER> <end: @R> =>
        ast::node(ids, start..end, ast::VarName::new(var_name)),
}

UnOp : ast::Node<ast::UnOp> = {
    <start: @L> "-" <end: @R> =>
        ast::node(ids, start..end, ast::UnOp::Neg),
    <start: @L> "!" <end: @R> =>
        ast::node(ids, start..end, ast::UnOp::Not),
}

EqOp : ast::Node<ast::BinOp> = {
    <start: @L> "==" <end: @R> => 
        ast::node(ids, start..end, ast::BinOp::Rel(ast::RelOp::Eq(ast::EqOp::Eq))),
    <start: @L> "!=" <end: @R> => 
        ast::node(ids, start..end, ast::BinOp::Rel(ast::RelOp::Eq(ast::EqOp::Ne))),
}

CmpOp : ast::Node<ast::BinOp> = {
    <start: @L> "<" <end: @R> =>
        ast::node(ids, start..end, ast::BinOp::Rel(ast::RelOp::Cmp(ast::CmpOp::Lt))),
    <start: @L> "<=" <end: @R> => 
        ast::node(ids, start..end, ast::BinOp::Rel(ast::RelOp::Cmp(ast::CmpOp::Le))),
    <start: @L> ">" <end: @R> => 
        ast::node(ids, start..end, ast::BinOp::Rel(ast::RelOp::Cmp(ast::CmpOp::Gt))),
    <start: @L> ">=" <end: @R> => 
        ast::node(ids, start..end, ast::BinOp::Rel(ast::RelOp::Cmp(ast::CmpOp::Ge))),
}

AddOp : ast::Node<ast::BinOp> = {
    <start: @L> "+" <end: @R> =>
        ast::node(ids, start..end, ast::BinOp::Add(ast::AddOp::Add)),
    <start: @L> "-" <end: @R> =>
        ast::node(ids, start..end, ast::BinOp::Add(ast::AddOp::Sub)),
}

MulOp : ast::Node<ast::BinOp> = {
    <start: @L> "*" <end: @R> =>
        ast::node(ids, start..end, ast::BinOp::Mul(ast::MulOp::Mul)),
    <start: @L> "/" <end: @R> =>
        ast::node(ids, start..end, ast::BinOp::Mul(ast::MulOp::Div)),
}

LogOpOr : ast::Node<ast::BinOp> = {
    <start: @L> KWRD_OR <end: @R> =>
        ast::node(ids, start..end, ast::BinOp::Log(ast::LogOp::Or)),
}

LogOpAnd : ast::Node<ast::BinOp> = {
    <start: @L> KWRD_AND <end: @R> =>
        ast::node(ids, start..end, ast::BinOp::Log(ast::LogOp::And)),
}

pub Expr : ast::Node<ast::Expr> = {
    <start: @L> <expr:Assign> <end: @R> =>
        ast::node(ids, start..end, ast::Expr::Assign(expr)),
    LogOr,
}

Assign : ast::Assign = {
    <name:VarName> "=" <val:Expr> => ast::Assign { name , val : Box::new(val) },
}

LogOr : ast::Node<ast::Expr> = {
    LogAnd,
    <start: @L> <l:LogOr> <op:LogOpOr> <r:LogAnd> <end: @R> => {
        let l = Box::new(l);
        let r = Box::new(r);
        ast::node(ids, start..end, ast::Expr::Bin(ast::BinExpr { op, l, r }))
    },
}

LogAnd : ast::Node<ast::Expr> = {
    EqExpr,
    <start: @L> <l:LogAnd> <op:LogOpAnd> <r:EqExpr> <end: @R> => {
        let l = Box::new(l);
        let r = Box::new(r);
        ast::node(ids, start..end, ast::Expr::Bin(ast::BinExpr { op, l, r }))
    },
}

EqExpr : ast::Node<ast::Expr> = {
    <start: @L> <l:EqExpr> <op:EqOp> <r:CmpExpr> <end: @R> => {
        let l = Box::new(l);
        let r = Box::new(r);
        ast::node(ids, start..end, ast::Expr::Bin(ast::BinExpr { op, l, r }))
    },
    CmpExpr,
}

CmpExpr : ast::Node<ast::Expr> = {
    <start: @L> <l:TermExpr> <op:CmpOp> <r:CmpExpr> <end: @R> => {
        let l = Box::new(l);
        let r = Box::new(r);
        ast::node(ids, start..end, ast::Expr::Bin(ast::BinExpr { op, l, r }))
    },
    TermExpr, 
}

TermExpr : ast::Node<ast::Expr> = {
    <start: @L> <l:FactorExpr> <op:AddOp> <r:TermExpr> <end: @R> => {
        let l = Box::new(l);
        let r = Box::new(r);
        ast::node(ids, start..end, ast::Expr::Bin(ast::BinExpr { op, l, r }))
    },
    FactorExpr ,
}

FactorExpr : ast::Node<ast::Expr> = {
    <start: @L> <l:UnExpr> <op:MulOp> <r:FactorExpr> <end: @R> => {
        let l = Box::new(l);
        let r = Box::new(r);
        ast::node(ids, start..end, ast::Expr::Bin(ast::BinExpr { op, l, r }))
    },
    UnExpr,
}

UnExpr : ast::Node<ast::Expr> = {
    <start: @L> <op:UnOp> <e:UnExpr> <end: @R> => {
        let e = Box::new(e);
        ast::node(ids, start..end, ast::Expr::Un(ast::UnExpr { op, e }))
    }
    CallExpr => <>
}

CallExpr : ast::Node<ast::Expr> = {
    PrimExpr => <>,
    <start: @L> <callee:PrimExpr> "(" <args:Args?> ")" <end: @R> =>? {
        let callee = Box::new(callee);
        let args =  args.unwrap_or_default();
        validate_arg_count(args.len())?;
        Ok(ast::node(ids, start..end, ast::Expr::Call(ast::Call { callee , args  })))
    }
}

Args : Vec<ast::Node<ast::Expr>> = {
    <first:Expr> <rest:("," <Expr>)*> => {
        let mut args = vec![first];
        args.extend(rest);
        args
    }
}

Lambda : ast::Node<ast::Fun> = {
    <start: @L> KWRD_FUN "(" <params:Params?> ")" <body:Block> <end: @R> => {
        let params = params.unwrap_or_default();
        ast::node(ids, start..end, ast::Fun { params, body })
    }
}

PrimExpr : ast::Node<ast::Expr> = {
    <start: @L> <lit:Lit> <end: @R> =>
        ast::node(ids, start..end, ast::Expr::Lit(lit)),
    <start: @L> <var_name:VarName> <end: @R> =>
        ast::node(ids, start..end, ast::Expr::Var(var_name)),
    "(" <Expr> ")",
    <start: @L> <lambda:Lambda> <end: @R> =>
        ast::node(ids, start..end, ast::Expr::Fun(lambda)),
}

pub Prog : ast::Node<ast::Prog> = {
    <start: @L> <stmts:DeclStmt*> <end: @R> => 
        ast::node(ids, start..end, ast::Prog(stmts)),
}

Stmt : ast::Node<ast::Stmt> = {
    MatchedStmt,
    UnmatchedStmt,
}

NonIfWhileForStmt : ast::Node<ast::Stmt> = {
    <start: @L> <expr:ExprStmt> <end: @R> =>
        ast::node(ids, start..end, ast::Stmt::Expr(expr)),
    <start: @L> <print:PrintStmt> <end: @R> =>
        ast::node(ids, start..end, ast::Stmt::Print(print)),
    <start: @L> <block:Block> <end: @R> =>
        ast::node(ids, start..end, ast::Stmt::Block(block)),
    <start: @L> KWRD_BREAK ";" <end: @R> =>
        ast::node(ids, start..end, ast::Stmt::Break),
    FunDecl => ast::Stmt::FunDecl(<>),
    RetStmt => ast::Stmt::Ret(<>),
}

MatchedStmt : ast::Node<ast::Stmt> = { 
    NonIfWhileForStmt,
    <start: @L> KWRD_IF "(" <cond:Expr> ")" <then:MatchedStmt> KWRD_ELSE <else_:MatchedStmt> <end: @R> => {
        let if_ = ast::IfStmt { cond, then : Box::new(then), else_: Some(Box::new(else_)) };
        let if_ = ast::node(ids, start..end, if_);
        ast::Stmt::If(if_)
    }
    <start: @L> KWRD_WHILE "(" <cond:Expr> ")" <body:MatchedStmt> <end: @R> => {
        let while_ = ast::WhileStmt { cond, body : Box::new(body) };
        let while_ = ast::node(ids, start..end, while_);
        ast::Stmt::While(while_)
    }
    <start: @L> KWRD_FOR "(" <init:ForInit> <cond:Expr?> ";" <incr:Expr?> ")" <body:MatchedStmt> <end: @R> =>
        desugar_for_stmt(ids, start..end, init, cond, incr, body),
}

UnmatchedStmt : ast::Node<ast::Stmt> = {
    <start: @L> KWRD_IF "(" <cond:Expr> ")" <then:Stmt> <end: @R> => {
        let if_ = ast::IfStmt { cond, then : Box::new(then), else_: None };
        let if_ = ast::node(ids, start..end, if_);
        ast::Stmt::If(if_)
    }
    <start: @L> KWRD_IF "(" <cond:Expr> ")" <then:MatchedStmt> KWRD_ELSE <else_:UnmatchedStmt> <end: @R> => {
        let if_ = ast::IfStmt { cond, then : Box::new(then), else_: Some(Box::new(else_)) };
        let if_ = ast::node(ids, start..end, if_);
        ast::Stmt::If(if_)
    }
    <start: @L> KWRD_WHILE "(" <cond:Expr> ")" <body:UnmatchedStmt> <end: @R> => {
        let while_ = ast::WhileStmt { cond, body : Box::new(body)};
        let while_ = ast::node(ids, start..end, while_);
        ast::Stmt::While(while_)
    }
    <start: @L> KWRD_FOR "(" <init:ForInit> <cond:Expr?> ";" <incr:Expr?> ")" <body:UnmatchedStmt> <end: @R> => 
        desugar_for_stmt(ids, start..end, init, cond, incr, body),
}

RetStmt : ast::Node<ast::RetStmt> = {
    <start: @L> KWRD_RETURN <expr:Expr?> ";" <end: @R> =>
        ast::node(ids, start..end, ast::RetStmt(expr)),
}

FunDecl : ast::Node<ast::FunDecl> = {
    <start: @L> KWRD_FUN <name:VarName> "(" <params:Params?> ")" <body:Block> <end: @R> => {
        let fun =  ast::Fun { params : params.unwrap_or_default(), body };
        ast::node(ids, start..end, ast::FunDecl { name, fun  })
    }
}

Params : Vec<ast::Node<ast::VarName>> = {
    <first:VarName> <rest:("," <VarName>)*> => {
        let mut params = vec![first];
        params.extend(rest);
        params
    }
}

ForInit : Option<ForInit> = {
    VarDecl => Some(ForInit::VarDecl(<>)),
    ExprStmt => Some(ForInit::Expr(<>)),
    ";" => None
}

VarDecl : ast::Node<ast::VarDecl> = {
    <start: @L> KWRD_VAR <name:VarName> <init:("=" <Expr>)?> ";" <end: @R> => 
        ast::node(ids, start..end, ast::VarDecl { name , init })
}


DeclStmt : ast::Node<ast::Stmt> = {
    <start: @L> <var_decl:VarDecl> <end: @R> =>
        ast::node(ids, start..end, ast::Stmt::VarDecl(var_decl)),
    Stmt,
}

Block : ast::Block = {
    "{" <DeclStmt*> "}" => ast::Block(<>),
}

ExprStmt : ast::ExprStmt = {
    <Expr> ";" => ast::ExprStmt(<>),
}

PrintStmt : ast::PrintStmt = {
    KWRD_PRINT <Expr> ";" => ast::PrintStmt(<>),
}
